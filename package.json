{
  "name": "learning-coding-daily",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts/*.mjs tests/e2e tests/*.ts *.ts *.json index.html",
    "format:check": "prettier --check src scripts/*.mjs tests/e2e tests/*.ts *.ts *.json index.html",
    "start": "node scripts/start.mjs",
    "build:web": "tsc --noEmit && vite build --mode web --outDir web-dist",
    "plan:check": "python3 scripts/planning.py check",
    "plan:render": "python3 scripts/planning.py render",
    "test:contracts": "node --experimental-strip-types --test tests/recommendation.test.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "8.3.4"
  }
}
